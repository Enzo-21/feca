    "seo": "node scripts/generate-seo-assets.mjs",
    "og": "node scripts/generate-og.mjs",
    "check:dev": "node scripts/check-dev.mjs",
    "pdf:ficha-tecnica": "node scripts/generate-documentos.mjs --only=ficha"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-pdf/renderer": "^4.9.0",
